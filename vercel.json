{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/report", "destination": "/report.html" },
    { "source": "/issues", "destination": "/issues.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/admin/complaints", "destination": "/admin.html" },
    { "source": "/admin/locations", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
