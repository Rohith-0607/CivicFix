{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/report", "destination": "/report.html" },
    { "source": "/issues", "destination": "/issues.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/my-complaints", "destination": "/my-complaints.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/complaints", "destination": "/admin/complaints.html" },
    { "source": "/admin/locations", "destination": "/admin/locations.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ]
}
